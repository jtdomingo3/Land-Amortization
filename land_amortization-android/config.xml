<?xml version='1.0' encoding='utf-8'?>
<widget id="com.landamortization.tracker" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Land Amortization Tracker</name>
    <description>Offline Land Amortization Tracker with SQLite and Google Drive export</description>
    <author email="support@gezynejamir.com" href="https://gezynejamir.com">
        Gezyne-Jamir Software Tech
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-navigation href="https://*/*" />
    <allow-navigation href="wss://*/*" />
    <allow-navigation href="http://*/*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <icon src="public/logo.png" />

    <feature name="NotificationPlugin">
        <param name="android-package" value="com.landamortization.tracker.NotificationPlugin" />
    </feature>

    <platform name="android">
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
            <uses-permission android:name="android.permission.VIBRATE" />
        </config-file>
        <allow-intent href="market:*" />
        <preference name="AndroidWindowSoftInputMode" value="adjustResize" />
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />
        <preference name="android-compileSdkVersion" value="34" />
        <preference name="android-buildToolsVersion" value="36.1.0" />
        <preference name="AndroidPersistentFileLocation" value="Compatibility" />
        <preference name="StatusBarBackgroundColor" value="#0f172a" />
        <preference name="StatusBarStyle" value="lightcontent" />
        <preference name="loadUrlTimeoutValue" value="70000" />
        <preference name="SplashScreenBackgroundColor" value="#0f172a" />
        <preference name="AndroidWindowSplashScreenBackground" value="#0f172a" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="public/logo.png" />
    </platform>
</widget>
